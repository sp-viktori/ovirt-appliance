<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="8.0" name="ovirt-engine-appliance">
    <description type="system">
        <author>oVirt Developers</author>
        <contact>devel@ovirt.org</contact>
        <specification>oVirt Appliance - Oracle Linux 9</specification>
    </description>
    <include from="file://kiwi/default.xml"/>
    <repository alias="ol9_baseos">
        <source path="https://yum.oracle.com/repo/OracleLinux/OL9/baseos/latest/x86_64/"/>
    </repository>
    <repository alias="ol9_appstream">
        <source path="https://yum.oracle.com/repo/OracleLinux/OL9/appstream/x86_64/"/>
    </repository>
    <repository alias="ol9_addons">
        <source path="https://yum.oracle.com/repo/OracleLinux/OL9/addons/x86_64/"/>
    </repository>
    <repository alias="ol9_codeready_builder">
        <source path="https://yum.oracle.com/repo/OracleLinux/OL9/codeready/builder/x86_64/"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=epel-9&amp;arch=x86_64"/>
    </repository>
    <!-- CentOS Stream 9 Extras SIG common: apache-commons-*,
         glassfish-servlet-api (Java/Maven deps not in OL9 or EPEL). -->
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-extras-sig-extras-common-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <!-- CentOS Stream 9 virt SIG ovirt-45: openstack-java-* 3.2.9,
         snmp4j, apache-sshd, ed25519-java, ws-commons-util, xmlrpc-client,
         ansible-runner — engine 4.5.8 transitive deps. -->
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-virt-sig-ovirt-45-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <!-- CentOS Stream 9 Storage SIG (ceph-squid): ceph-common. -->
    <repository alias="centos-storage-ceph-squid">
        <source path="https://buildlogs.centos.org/centos/9-stream/storage/x86_64/ceph-squid/"/>
    </repository>
    <!-- CentOS Stream 9 Cloud SIG (openstack-antelope): python3-cinderlib. -->
    <repository alias="centos-cloud-openstack-antelope">
        <source path="https://mirror.stream.centos.org/SIGs/9-stream/cloud/x86_64/openstack-antelope/"/>
    </repository>
    <!-- CentOS Stream 9 NFV SIG (openvswitch-2): python3-openvswitch2.17,
         needed by ovirt-python-openvswitch -> ovirt-provider-ovn -> engine. -->
    <repository alias="centos-nfv-openvswitch-2">
        <source path="https://mirror.stream.centos.org/SIGs/9-stream/nfv/x86_64/openvswitch-2/"/>
    </repository>
    <!-- COPR -->
    <repository alias="copr_ovirt-master-snapshot" profiles="copr">
        <source path="https://download.copr.fedorainfracloud.org/results/ovirt/ovirt-master-snapshot/centos-stream-9-x86_64/">
            <signing key="https://download.copr.fedorainfracloud.org/results/ovirt/ovirt-master-snapshot/pubkey.gpg"/>
        </source>
    </repository>
    <packages type="image" profiles="copr">
        <package name="ovirt-release-master"/>
    </packages>
    <!-- CBS Testing (CentOS Stream Virt SIG ovirt-45 testing) -->
    <repository alias="centos-virt-extras" profiles="cbs-testing">
        <source path="https://buildlogs.centos.org/centos/9-stream/extras/x86_64/extras-common/"/>
    </repository>
    <packages type="image" profiles="cbs-testing">
        <package name="centos-release-ovirt45-testing"/>
    </packages>
    <!-- CBS Release -->
    <packages type="image" profiles="cbs-release">
        <package name="centos-release-ovirt45"/>
    </packages>
    <!-- StorPool patched engine: highest priority (lower priority number wins).
         @OLVM_CACHE_URL@ is substituted by olvm/build/build-appliance.sh from
         $OLVM_CACHE_URL before kiwi runs. -->
    <repository alias="olvm-storpool" priority="1">
        <source path="@OLVM_CACHE_URL@/ol9/"/>
    </repository>
    <!-- OL release package: kiwi only activates the composite profile
         (oraclelinux-copr etc), not a bare "oraclelinux", so packages.xml's
         profile-gated bootstrap doesn't match. Pin the release rpm here. -->
    <packages type="bootstrap">
        <package name="oraclelinux-release-el9"/>
    </packages>
    <include from="file://kiwi/packages.xml"/>
</image>
